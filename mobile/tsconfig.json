{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["../*"],
      "date-fns": ["./node_modules/date-fns"],
      "date-fns/*": ["./node_modules/date-fns/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
